# Veritabanı (Neon)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Kimlik doğrulama (Auth.js) — üret: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Hash tuzu — rate limit anahtarı + IP özeti için (32+ bayt rastgele)
HASH_PEPPER=

# Tohum: ilk admin kullanıcısı (yalnızca db:seed sırasında okunur)
ADMIN_INITIAL_EMAIL=admin@ateliermotors.com
ADMIN_INITIAL_PASSWORD=

# Uygulama — siteConfig.url karşılığı, gerçek alan adı gelince değişir
NEXT_PUBLIC_SITE_URL=https://ateliermotors.example

# E-posta gönderimi (iletişim formu bildirimi) — SMTP_HOST + INQUIRY_NOTIFY_EMAIL tanımlıysa gönderir
# Resend örneği: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASSWORD=re_...
# SMTP_FROM: gönderen adres — Resend'te doğrulanmış alan adına ait olmalı
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_NOTIFY_EMAIL=
